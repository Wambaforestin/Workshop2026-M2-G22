{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Resilience-Alpha — Supervision",
  "uid": "resilience-alpha",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "État base de paiement",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "payment_db_up", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [
        { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
      ] } }
    },
    {
      "type": "timeseries",
      "title": "Requêtes/s par statut",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [{
        "expr": "sum by (status) (rate(payment_requests_total[1m]))",
        "legendFormat": "{{status}}", "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Latence p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(payment_request_latency_seconds_bucket[1m])) by (le))",
        "legendFormat": "p95", "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Transactions par résultat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "sum by (result) (rate(payment_transactions_total[1m]))",
        "legendFormat": "{{result}}", "refId": "A"
      }]
    },
    {
      "type": "logs",
      "title": "Journaux (Loki)",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{container=~\".*(payment-api|waf|remediation|ml-detection).*\"}", "refId": "A" }]
    }
  ]
}
